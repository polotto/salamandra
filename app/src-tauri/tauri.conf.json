{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Salamandra",
  "version": "0.4.1",
  "identifier": "com.polotto.salamandra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Salamandra",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Configurador aberto de mouses gamer",
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-salamandra.rules": "../../packaging/linux/70-salamandra.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-salamandra.rules": "../../packaging/linux/70-salamandra.rules"
        },
        "postInstallScript": "../../packaging/linux/postinst.sh"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
